{
  "name": "dashboard",
  "main": "src/index.js",
  "compatibility_date": "2026-05-22",
  "workers_dev": true,
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "MODE": "production",
    "SITE": "enabled"
  },
  // ÉcoleDirecte credentials live on ed-client-worker (ED_USERNAME /
  // ED_PASSWORD set directly on that worker) and MEGA credentials on
  // mega-client-worker (MEGA_EMAIL / MEGA_PASSWORD) — this worker only
  // proxies through service bindings.
  "env": {
    "production": {
      "vars": {
      }
    }
  },
  "ai": {
    "name": "AI",
    "binding": "AI"
  },
  "services": [
    {
      "binding": "AUTH_CLIENT_WORKER",
      "service": "authentication-client-worker"
    },
    {
      "binding": "ED_CLIENT",
      "service": "ed-client-worker"
    },
    {
      "binding": "MEGA_CLIENT",
      "service": "mega-client-worker"
    }
  ],
  "d1_databases": [
    { "binding": "timetable", "database_name": "timetable", "database_id": "e90910eb-6dd0-4e5e-a6d9-88cae3759dde" },
    { "binding": "subjects_data", "database_name": "subjects_data", "database_id": "76bb4641-3e6b-446e-ba44-61471c028dac" },
    { "binding": "school_data", "database_name": "school_data", "database_id": "6261427c-8962-4c0c-91e0-cb667e8f5f13" },
    { "binding": "emails", "database_name": "emails", "database_id": "abc9ed10-0376-4c42-a361-266060d50cc2" },
    { "binding": "settings", "database_name": "settings", "database_id": "3d41d88a-e2f3-4b30-bfec-97fc49a4004a" },
    { "binding": "storage", "database_name": "storage", "database_id": "9cfb9eb2-8f45-4b86-8ab1-3807928e644a" }
  ],
  "workflows": [
    {
      "name": "check_grades",
      "binding": "CHECK_GRADES",
      "class_name": "CheckGradesWorkflow"
    }
  ],
  // No cron here — scheduled jobs moved to the `crons-client-worker`.
  // NOTE: the check_grades workflow is no longer triggered automatically.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
