{
  "name": "dashboard",
  "main": "src/index.js",
  "compatibility_date": "2026-05-22",
  "workers_dev": true,
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "MODE": "production",
    "SITE": "enabled"
  },
  // ÉcoleDirecte credentials live on ed-client-worker (ED_USERNAME /
  // ED_PASSWORD set directly on that worker) and MEGA credentials on
  // mega-client-worker (MEGA_EMAIL / MEGA_PASSWORD) — this worker only
  // proxies through service bindings.
  "env": {
    "production": {
      "vars": {
      }
    }
  },
  "ai": {
    "name": "AI",
    "binding": "AI"
  },
  "services": [
    {
      "binding": "AUTH_CLIENT_WORKER",
      "service": "authentication-client-worker"
    },
    {
      "binding": "ED_CLIENT",
      "service": "ed-client-worker"
    },
    {
      "binding": "MEGA_CLIENT",
      "service": "mega-client-worker"
    }
  ],
  "d1_databases": [
    { "binding": "timetable", "database_name": "timetable", "database_id": "__D1_ID_TIMETABLE__" },
    { "binding": "subjects_data", "database_name": "subjects_data", "database_id": "__D1_ID_SUBJECTS_DATA__" },
    { "binding": "school_data", "database_name": "school_data", "database_id": "__D1_ID_SCHOOL_DATA__" },
    { "binding": "emails", "database_name": "emails", "database_id": "__D1_ID_EMAILS__" },
    { "binding": "settings", "database_name": "settings", "database_id": "__D1_ID_SETTINGS__" },
    { "binding": "storage", "database_name": "storage", "database_id": "__D1_ID_STORAGE__" }
  ],
  "workflows": [
    {
      "name": "check_grades",
      "binding": "CHECK_GRADES",
      "class_name": "CheckGradesWorkflow"
    }
  ],
  // No cron here — scheduled jobs moved to the `crois` worker.
  // NOTE: the check_grades workflow is no longer triggered automatically.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
